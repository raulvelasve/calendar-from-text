{
    "manifest_version": 3,
    "name": "Arbitro Calendar FBVIB",
    "version": "1.0.0",
    "description": "Pega uno o varios partidos y crea los eventos correspondientes en Google Calendar, incluyendo título, fecha, hora y ubicación.",
    "icons": {
        "128": "icons/images.png"
    },
    "action": {
        "default_title": "Crear evento"
    },
    "permissions": [
        "storage",
        "sidePanel",
        "tabs"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    }
}